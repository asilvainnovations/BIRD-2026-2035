# BIRD 2026–2035 · browser environment variables
# Copy to .env.local for development. In production, set these in
# Netlify → Site configuration → Environment variables.
#
# Everything prefixed VITE_ is compiled INTO the public JavaScript bundle.
# Only browser-safe values belong here. NEVER put a Supabase service-role key,
# ANTHROPIC/Moonshot API key, Resend key or any other secret in a VITE_ variable —
# Edge Functions read those from Supabase secrets.

# Supabase project (auth + data + Edge Functions): lydsisparsmvextskevw
VITE_SUPABASE_URL=https://lydsisparsmvextskevw.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: override if Edge Functions are ever hosted elsewhere.
# Defaults to ${VITE_SUPABASE_URL}/functions/v1
# VITE_SUPABASE_FUNCTIONS_URL=

# Optional: Sentry error monitoring (disabled when unset)
# VITE_SENTRY_DSN=

# Optional asset / companion-app overrides
# VITE_BRAND_LOGO_URL=
# VITE_AI_STRATEGIST_AVATAR_URL=
# VITE_BANNER_INVESTMENT_URL=
# VITE_PWA_EXTERNAL_URL=
# VITE_USER_MANUAL_URL=
# VITE_DEVELOPER_DOCS_URL=
